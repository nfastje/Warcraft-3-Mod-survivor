# --- Never publish Blizzard game data -------------------------------------
# release/ holds the portable build, which bundles the Warcraft III install
# (War3.mpq and friends). Tester builds are uploaded as GitHub Releases, not
# committed.
/release/
*.mpq
*.MPQ

# Zone thumbnails are screenshots of Blizzard's maps and textures. Make them
# locally with tools/engine_tests/test_zone_shot.lua (see CLAUDE.md).
src/art/zone_*.tga

# --- The engine -------------------------------------------------------------
# engine/ is the OpenRealm fork (Willios/open-realm-williosfork, branch
# survivor), added to this repository as a squashed git subtree. Its own
# .gitignore keeps the build output (build/, build-windows*/, dist/) out.

# --- Local and generated files ---------------------------------------------
map/*.w3mTemp/
.vscode/
.claude/
__pycache__/
*.pyc
*.pld

# Reference maps supplied by the user (Blizzard data)
/Custom map/
